# Card-news publish CLI tokens — copy to .env (not committed)
# All tokens here expire in ~60 days. Re-run setup procedure in docs/PUBLISH_SETUP.md.

# ---------- Threads (Meta Graph API) ----------
# Find via Graph API Explorer with scopes: threads_basic, threads_content_publish
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ---------- LinkedIn (Document Share) ----------
# OAuth scope: w_member_social  (+ openid profile to bootstrap URN via /v2/userinfo)
# URN format: urn:li:person:<sub from userinfo>
LINKEDIN_AUTHOR_URN=urn:li:person:xxxxx
LINKEDIN_ACCESS_TOKEN=

# ---------- PNG image hosting (Threads requires public URLs) ----------
# "0x0"   (default): https://0x0.st free temp host, 24h expiry, no setup
# "github" : push to a private branch and use raw.githubusercontent.com
IMAGE_HOST_PROVIDER=0x0

# Only required when IMAGE_HOST_PROVIDER=github
GITHUB_TOKEN=
GITHUB_HOST_REPO=
GITHUB_HOST_BRANCH=card-news-host
